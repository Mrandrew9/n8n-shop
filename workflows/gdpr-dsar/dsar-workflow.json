{
  "name": "GDPR Data Subject Request (DSAR)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "dsar-request",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "7b014196-03f7-54e4-8358-2cd42e355493",
      "name": "DSAR Request Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validate the incoming request and compute the GDPR Art. 12(3) deadline:\n// one calendar month from receipt (clamped to month end, e.g. 31 Jan -> 28/29 Feb).\nconst body = $input.first().json.body ?? $input.first().json;\nconst type = String(body.requestType ?? '').trim().toLowerCase();\nconst email = String(body.email ?? '').trim().toLowerCase();\n\nif (!['access', 'erasure'].includes(type)) {\n  throw new Error(`requestType must be \"access\" or \"erasure\", got \"${body.requestType}\"`);\n}\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) {\n  throw new Error('A valid email address is required');\n}\n\nfunction addOneMonth(date) {\n  const y = date.getUTCFullYear();\n  const m = date.getUTCMonth() + 1;\n  const lastDay = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();\n  return new Date(Date.UTC(y, m, Math.min(date.getUTCDate(), lastDay)));\n}\n\nconst received = body.receivedAt ? new Date(body.receivedAt) : new Date();\nif (isNaN(received)) throw new Error('receivedAt is not a valid date');\nconst stamp = received.toISOString().slice(0, 10).replace(/-/g, '');\nconst suffix = Math.random().toString(36).slice(2, 7).toUpperCase();\n\nreturn [{\n  json: {\n    requestId: `DSAR-${stamp}-${suffix}`,\n    requestType: type,\n    email,\n    fullName: String(body.fullName ?? '').trim(),\n    receivedAt: received.toISOString(),\n    deadline: addOneMonth(received).toISOString().slice(0, 10),\n  },\n}];\n"
      },
