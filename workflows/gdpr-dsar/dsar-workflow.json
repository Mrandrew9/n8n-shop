    {
      "parameters": {
        "jsCode": "// Combine the three lookups into one inventory of where this person's data lives.\n// Each lookup node runs with \"continue on error\", so a missing account is not a failure.\nconst req = $('Normalize Request').first().json;\nconst slack = $('Find in Slack').first().json;\nconst google = $('Find in Google Workspace').first().json;\nconst jira = $('Find in Jira').first().json;\n\nconst systems = [];\n\nif (slack && slack.ok && slack.user) {\n  systems.push({\n    system: 'Slack',\n    found: true,\n    accountId: slack.user.id,\n    data: {\n      displayName: slack.user.profile?.display_name,\n      realName: slack.user.profile?.real_name,\n      title: slack.user.profile?.title,\n      timezone: slack.user.tz,\n      deleted: slack.user.deleted,\n    },\n  });\n} else {\n  systems.push({ system: 'Slack', found: false });\n}\n\nif (google && google.primaryEmail) {\n  systems.push({\n    system: 'Google Workspace',\n    found: true,\n    accountId: google.id,\n    data: {\n      primaryEmail: google.primaryEmail,\n      name: google.name?.fullName,\n      orgUnitPath: google.orgUnitPath,\n      lastLoginTime: google.lastLoginTime,\n      creationTime: google.creationTime,\n      suspended: google.suspended,\n    },\n  });\n} else {\n  systems.push({ system: 'Google Workspace', found: false });\n}\n\nconst jiraUser = Array.isArray(jira) ? jira[0] : (jira && jira.accountId ? jira : null);\nif (jiraUser && jiraUser.accountId) {\n  systems.push({\n    system: 'Jira',\n    found: true,\n    accountId: jiraUser.accountId,\n    data: {\n      displayName: jiraUser.displayName,\n      active: jiraUser.active,\n      timeZone: jiraUser.timeZone,\n    },\n  });\n} else {\n  systems.push({ system: 'Jira', found: false });\n}\n\nconst found = systems.filter((s) => s.found);\nreturn [{\n  json: {\n    ...req,\n    systems,\n    systemsFound: found.map((s) => s.system).join(', ') || 'none',\n    slackUserId: found.find((s) => s.system === 'Slack')?.accountId ?? null,\n    jiraAccountId: found.find((s) => s.system === 'Jira')?.accountId ?? null,\n    hasGoogleAccount: found.some((s) => s.system === 'Google Workspace'),\n    generatedAt: new Date().toISOString(),\n  },\n}];\n"
      },
