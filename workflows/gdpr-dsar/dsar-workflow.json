    {
      "parameters": {
        "jsCode": "// Validate the request, apply the rules for its jurisdiction, and compute deadlines.\n// To support another law, add an entry to RULES. Deadlines run from receipt, not from verification.\nconst RULES = {\n  GDPR: {\n    name: 'GDPR (EU/EEA)',\n    deadline: { months: 1 }, // Art. 12(3)\n    extension: { months: 2 }, // Art. 12(3): up to two further months, with notice\n    acknowledgeWithin: null, // no separate acknowledgment deadline\n    refs: { access: 'Article 15 GDPR', erasure: 'Article 17 GDPR', correction: 'Article 16 GDPR' },\n    erasureExceptions: 'Art. 17(3) exceptions: legal obligations (e.g. employment and tax record retention), legal claims, legal holds',\n    complaint: 'You have the right to lodge a complaint with a supervisory authority and to seek a judicial remedy (Article 12(4) GDPR).',\n  },\n  CCPA: {\n    name: 'CCPA/CPRA (California)',\n    deadline: { days: 45 }, // Cal. Code Regs. tit. 11, § 7021(b)\n    extension: { days: 45 }, // § 7021(b): up to 90 days in total, with notice and the reason\n    acknowledgeWithin: { businessDays: 10 }, // § 7021(a)\n    refs: {\n      access: 'the California Consumer Privacy Act (right to know)',\n      erasure: 'the California Consumer Privacy Act (right to delete)',\n      correction: 'the California Consumer Privacy Act (right to correct)',\n    },\n    erasureExceptions: 'Cal. Civ. Code § 1798.105(d) exceptions: legal obligations, security and fraud detection, internal uses the person would reasonably expect',\n    complaint: 'If you believe your request was not handled correctly, you may contact the California Privacy Protection Agency.',\n  },\n};\nconst TYPE_ALIASES = {\n  access: 'access', know: 'access',\n  erasure: 'erasure', delete: 'erasure', deletion: 'erasure',\n  correction: 'correction', correct: 'correction', rectification: 'correction',\n};\n\nconst body = $input.first().json.body ?? $input.first().json;\nconst jurisdiction = String(body.jurisdiction ?? 'GDPR').trim().toUpperCase();\nconst rules = RULES[jurisdiction];\nif (!rules) throw new Error(`jurisdiction must be one of ${Object.keys(RULES).join(', ')}, got \"${body.jurisdiction}\"`);\n\nconst type = TYPE_ALIASES[String(body.requestType ?? '').trim().toLowerCase()];\nif (!type) throw new Error(`requestType must be one of ${Object.keys(TYPE_ALIASES).join(', ')}, got \"${body.requestType}\"`);\n\nconst email = String(body.email ?? '').trim().toLowerCase();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) throw new Error('A valid email address is required');\n\nconst details = String(body.details ?? '').trim();\nif (type === 'correction' && !details) throw new Error('Correction requests need \"details\": what is wrong and what it should say');\n\n// ---------- date helpers (UTC) ----------\nfunction addMonths(date, n) {\n  const y = date.getUTCFullYear();\n  const m = date.getUTCMonth() + n;\n  const lastDay = new Date(Date.UTC(y, m + 1, 0)).getUTCDate();\n  return new Date(Date.UTC(y, m, Math.min(date.getUTCDate(), lastDay)));\n}\nfunction addDays(date, n) {\n  return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate() + n));\n}\n// Counts Monday-Friday only. Public holidays are not excluded, so the result is conservative.\nfunction addBusinessDays(date, n) {\n  let d = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));\n  let added = 0;\n  while (added < n) {\n    d = addDays(d, 1);\n    const dow = d.getUTCDay();\n    if (dow !== 0 && dow !== 6) added += 1;\n  }\n  return d;\n}\nfunction apply(date, period) {\n  if (period.months) return addMonths(date, period.months);\n  if (period.days) return addDays(date, period.days);\n  if (period.businessDays) return addBusinessDays(date, period.businessDays);\n  throw new Error('Unknown period');\n}\nconst day = (d) => d.toISOString().slice(0, 10);\n\nconst received = body.receivedAt ? new Date(body.receivedAt) : new Date();\nif (isNaN(received)) throw new Error('receivedAt is not a valid date');\nconst deadline = apply(received, rules.deadline);\n// Count month-based extensions from receipt (31 Jan + 3 months = 30 Apr), not from the clamped deadline.\nconst extendedDeadline = rules.deadline.months && rules.extension.months\n  ? addMonths(received, rules.deadline.months + rules.extension.months)\n  : apply(deadline, rules.extension);\nconst stamp = day(received).replace(/-/g, '');\nconst suffix = Math.random().toString(36).slice(2, 7).toUpperCase();\n\nreturn [{\n  json: {\n    requestId: `DSAR-${stamp}-${suffix}`,\n    jurisdiction,\n    jurisdictionName: rules.name,\n    requestType: type,\n    email,\n    fullName: String(body.fullName ?? '').trim(),\n    details,\n    receivedAt: received.toISOString(),\n    deadline: day(deadline),\n    extendedDeadline: day(extendedDeadline),\n    acknowledgeBy: rules.acknowledgeWithin ? day(apply(received, rules.acknowledgeWithin)) : '',\n    legalRef: rules.refs[type],\n    erasureExceptions: rules.erasureExceptions,\n    complaintText: rules.complaint,\n  },\n}];\n"
      },
